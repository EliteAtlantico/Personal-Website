// The site on Cloudflare: dist/, served from Cloudflare's edge, and the Worker
// (edge/worker.ts), which answers /api/*. Cloudflare builds and deploys main
// on every push.
{
  // The Worker's name in Cloudflare's dashboard.
  "name": "personal-website",
  "main": "edge/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Only /api/* runs the Worker. Pages and files come straight from the edge, with the
    // headers in dist/_headers: faster, free, and still up if the Worker's daily limit runs out.
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
