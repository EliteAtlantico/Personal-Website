# The website's server on the desk (server/main.ts, built into ~/site/server.mjs).
# It listens on localhost only; the tunnel (cloudflared.service) is how
# Cloudflare reaches it. deploy/deploy.sh installs and restarts it.
[Unit]
Description=chaghouri: the website, on localhost for the Cloudflare tunnel
After=network-online.target

[Service]
ExecStart=/usr/bin/node %h/site/server.mjs
Environment=SITE_DIST=%h/site/dist HOST=127.0.0.1 PORT=8787 "DESK_NAME=my Arch desktop"
Restart=always
RestartSec=2
# It only ever reads the site, so that's all it may do.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M

[Install]
WantedBy=default.target
