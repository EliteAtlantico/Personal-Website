{
  "name": "chaghouri-times",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/prerender.ts && bun scripts/compress.ts",
    "build:server": "bun build server/main.ts --target=node --format=esm --outfile=build/server.mjs",
    "serve": "bun run build:server && node build/server.mjs",
    "deploy": "deploy/deploy.sh",
    "perf": "bun perf/run.ts",
    "fonts": "bun scripts/fonts.ts",
    "security": "bun security/run.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "resume": "cd resume && tectonic -X compile khalil_chaghouri_resume.tex && tectonic -X compile khalil_chaghouri_resume_public.tex && cp khalil_chaghouri_resume_public.pdf ../public/resume.pdf"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/topojson-client": "^3.1.5",
    "hyphen": "^1.14.1",
    "image-size": "^2.0.4",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.4",
    "topojson-client": "3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "world-atlas": "2.0.2"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "marked": "^18.0.14",
    "yaml": "^2.9.1"
  }
}
